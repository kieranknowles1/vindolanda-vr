	langid = {english},
	file = {PDF:/home/kieran/Zotero/storage/FKWV79WJ/Kim et al. - 2018 - Virtual reality sickness questionnaire (VRSQ) Motion sickness measurement index in a virtual realit.pdf:application/pdf},
}

